# --- environment / build ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.uv-cache/
.pytest_cache/

# --- secrets ---
.env

# --- runtime artifacts (regenerated by every batch run) ---
# Per-run trace directories: traces.jsonl, scores.jsonl, flips.jsonl,
# candidates_redacted.jsonl, report.md
runs/*
!runs/.gitkeep

# Long-lived experiment memory accumulated across runs:
# retrieval_sources.jsonl, successful_patterns_redacted.jsonl,
# failed_mutations.jsonl, judge_disagreements.jsonl, category_lessons.jsonl
memory/*
!memory/.gitkeep

# GEPA-optimized prompt programs written by `jbh gepa`
# (The frozen prompt used for the paper sweep is checked in by hand.)
prompts/optimized/*
!prompts/optimized/.gitkeep
!prompts/optimized/gepa_20260523_130239/

# --- log files ---
*.log

# --- LaTeX build artifacts ---
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# --- IDE / agent / OS noise ---
.idea/
.vscode/
.opencode/
.DS_Store
*.swp

# --- paper LaTeX source lives outside the repo ---
Automated_Indic_Jailbreaking_Harness_Prahlada/
paper/

# Revision V2 frozen banks contain full research prompts; keep private by default.
probe_banks/*
!probe_banks/.gitkeep
