# --- environment / build ---
.venv/
.analysis-venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
.uv-cache/
.matplotlib-cache/
.pytest_cache/
node_modules/
tmp/

# --- secrets ---
.env

# --- runtime artifacts (regenerated by every batch run) ---
# Per-run trace directories: traces.jsonl, scores.jsonl, flips.jsonl,
# candidates_redacted.jsonl, report.md
runs/*
!runs/.gitkeep

# Long-lived experiment memory accumulated across runs:
# retrieval_sources.jsonl, successful_patterns_redacted.jsonl,
# failed_mutations.jsonl, judge_disagreements.jsonl, category_lessons.jsonl
memory/*
!memory/.gitkeep

# Generator-guidance program directories written by `jbh gepa`.
# Only the artifact whose generator.txt SHA-256 matches the frozen bank
# manifest's `gepa_instruction_sha256` is tracked; exploratory runs are not.
prompts/optimized/*
!prompts/optimized/.gitkeep
!prompts/optimized/README.md
!prompts/optimized/gepa_20260826_135819/
!prompts/optimized/_superseded_v1_gepa_20260523_130239/

# --- log files ---
*.log

# --- LaTeX build artifacts ---
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.lof
*.out
*.toc
*.nav
*.snm
*.vrb
*.synctex.gz
paper/*.pdf
paper/**/*.pdf

# --- IDE / agent / OS noise ---
.idea/
.vscode/
.opencode/
.DS_Store
*.swp

# --- legacy paper copy lives outside the repo ---
Automated_Indic_Jailbreaking_Harness_Prahlada/

# Revision V2 frozen banks contain full research prompts; keep private by default.
probe_banks/*
!probe_banks/.gitkeep

# Local immutable snapshots contain the same private prompt/response material.
frozen_final_*/bank/
frozen_final_*/run/

# Annotation workbooks embed full harmful prompts and target responses, so they
# follow the same gated-release policy as the bank and the frozen run. Their
# SHA-256 hashes are recorded in human_validation/HUMAN_VALIDATION_MANIFEST.json,
# and human_validation/private/*.csv (identifiers, hashes and scores only, no
# prompt or response text) stays tracked so the sample remains auditable.
human_validation/outputs/**/*.xlsx

# Node toolchain for the human-validation workbook builder
human_validation/node_modules

# Excel lock files
~$*
