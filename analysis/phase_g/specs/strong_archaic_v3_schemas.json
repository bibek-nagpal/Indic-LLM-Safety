  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prahlada:phase-g:u-arch-v3",
  "title": "U-ARCH-v3 generation and certification output schemas",
  "description": "Local specification only. Validate an output against the named $defs entry. Acceptance also requires the protocol's semantic predicates; schema validity alone is not acceptance.",
  "$defs": {
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "U-ARCH-v3"
        },
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "cannot_preserve"
          ]
        },
        "u_text": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "item_id",
        "status",
        "u_text",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "candidate"
              }
            }
          },
          "then": {
            "properties": {
              "u_text": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "cannot_preserve"
              }
            }
          },
          "then": {
            "properties": {
              "u_text": {
                "const": ""
              }
            }
          }
        }
      ]
    },
